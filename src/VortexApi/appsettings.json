{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Vortex": ""
  },
  "Jwt": {
    "Issuer": "https://hub.vortex.local",
    "AccessTokenMinutes": 15,
    "ProductRefreshTokenDays": 30,
    "AdminRefreshTokenHours": 12,
    "IntegrationTokenMinutes": 60,
    "SigningKeyPem": null,
    "SigningKeyPath": null,
    "GenerateKeyIfMissing": false
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 20,
    "IntegrationPermitsPerMinute": 600
  },
  "Docs": {
    "Enabled": true
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "PublicLinks": {
    "BaseUrl": null,
    "Secret": null
  },
  "Webhooks": {
    "DispatcherEnabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 10,
    "TimeoutSeconds": 10,
    "AllowPrivateNetworks": false,
    "AllowInsecureHttp": false
  },
  "Fiscal": {
    "ProcessorEnabled": true,
    "PollIntervalSeconds": 10,
    "BatchSize": 20,
    "MaxAttempts": 12,
    "TimeoutSeconds": 60,
    "SecretKey": null
  },
  "Seed": {
    "AdminEmail": null,
    "AdminPassword": null,
    "ProductKeys": {}
  }
}
