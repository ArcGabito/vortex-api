@api = http://localhost:5299
@productKey = vxp_erp_dev_key_change_me
@deviceId = 3f0c2a8e-6a1b-4c1e-9d55-0f2b7d8e9a10

### 1. Login de administración (PlatformAdmin creado en Development)
# @name admin
POST {{api}}/api/admin/auth/login
Content-Type: application/json

{ "email": "admin@vortex.local", "password": "Vortex-Admin-2026!" }

### 2. Crear organización
# @name org
POST {{api}}/api/admin/organizations
Authorization: Bearer {{admin.response.body.accessToken}}
Content-Type: application/json

{ "name": "Acme SA", "taxId": "20123456789", "contactEmail": "ti@acme.com" }

### 3. Habilitar Vortex ERP (sin límites ni vencimiento; todos los campos son opcionales)
PUT {{api}}/api/admin/organizations/{{org.response.body.id}}/products/ERP
Authorization: Bearer {{admin.response.body.accessToken}}
Content-Type: application/json

{ "features": ["contabilidad", "nomina"] }

### 3b. Habilitar también Vortex CRM, dando acceso automático a todos los usuarios
PUT {{api}}/api/admin/organizations/{{org.response.body.id}}/products/CRM
Authorization: Bearer {{admin.response.body.accessToken}}
Content-Type: application/json

{ "autoAssignUsers": true }

### 4. Crear usuario
# @name user
POST {{api}}/api/admin/users
Authorization: Bearer {{admin.response.body.accessToken}}
Content-Type: application/json

{
  "organizationId": "{{org.response.body.id}}",
  "email": "ana@acme.com",
  "fullName": "Ana Pérez",
  "password": "Clave-Segura-2026!",
  "role": "User"
}

### 5. Dar acceso al ERP con un rol (y, si se quiere, solo en algunas sedes: "siteIds": ["…"])
PUT {{api}}/api/admin/organizations/{{org.response.body.id}}/products/ERP/members/{{user.response.body.id}}
Authorization: Bearer {{admin.response.body.accessToken}}
Content-Type: application/json

{ "role": "contador" }

### 6. Login desde Vortex ERP
# @name session
POST {{api}}/api/auth/login
X-Vortex-Product: ERP
X-Vortex-Product-Key: {{productKey}}
Content-Type: application/json

{
  "email": "ana@acme.com",
  "password": "Clave-Segura-2026!",
  "deviceId": "{{deviceId}}",
  "deviceName": "Laptop Ana",
  "platform": "windows"
}

### 7. Sistemas a los que Ana puede entrar (ERP y CRM)
GET {{api}}/api/access/products
Authorization: Bearer {{session.response.body.accessToken}}

### 8. Heartbeat (verificación periódica)
POST {{api}}/api/access/heartbeat
Authorization: Bearer {{session.response.body.accessToken}}

### 9. Renovar sesión
POST {{api}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{session.response.body.refreshToken}}", "deviceId": "{{deviceId}}" }

### 10. Llaves públicas
GET {{api}}/.well-known/jwks.json

### ---------- Fase 2: datos maestros ----------

### 11. Cliente creado desde el sistema con Id propio (sirve para sincronizar sin conexión)
PUT {{api}}/api/master/parties/0b6c1f7e-2d3a-4c55-9a11-6f0e8b2d4c01
Authorization: Bearer {{session.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Bodega Don Pepe",
  "documentType": "RUC",
  "documentNumber": "20123456789",
  "email": "compras@donpepe.pe",
  "address": { "line": "Av. Perú 123", "district": "Breña", "city": "Lima", "countryCode": "PE" }
}

### 12. Buscar cliente por documento antes de crearlo
GET {{api}}/api/master/parties?documentNumber=20123456789
Authorization: Bearer {{session.response.body.accessToken}}

### 13. Artículo
# @name item
POST {{api}}/api/master/items
Authorization: Bearer {{session.response.body.accessToken}}
Content-Type: application/json

{ "sku": "CAFE-250", "name": "Café tostado 250 g", "price": 18.50, "taxCode": "igv", "barcode": "7750000000017" }

### 14. Actualizar el artículo solo si nadie lo cambió (If-Match con la versión)
PUT {{api}}/api/master/items/{{item.response.body.id}}
Authorization: Bearer {{session.response.body.accessToken}}
If-Match: "1"
Content-Type: application/json

{ "sku": "CAFE-250", "name": "Café tostado 250 g", "price": 19.90, "taxCode": "igv", "barcode": "7750000000017" }

### 15. Sede / almacén
POST {{api}}/api/master/sites
Authorization: Bearer {{session.response.body.accessToken}}
Content-Type: application/json

{ "code": "ALM-01", "name": "Almacén central", "kind": "Warehouse", "address": { "city": "Lima", "countryCode": "PE" } }

### 16. Datos de la empresa (lectura: sistemas; escritura: OrgAdmin)
GET {{api}}/api/master/company
Authorization: Bearer {{session.response.body.accessToken}}

### 17. Feed de cambios desde el inicio
GET {{api}}/api/master/changes?since=0&limit=200
Authorization: Bearer {{session.response.body.accessToken}}

### ---------- Fase 3: eventos de integración ----------

### 18. Publicar una venta desde el sistema (el id lo genera el sistema; reintentar no duplica)
POST {{api}}/api/events
Authorization: Bearer {{session.response.body.accessToken}}
Content-Type: application/json

{
  "id": "5d1f0c3e-8a8b-4f0e-9b6a-2c7d9e1f0a11",
  "type": "sale.completed",
  "subjectType": "sale",
  "subjectId": "B001-000123",
  "data": { "total": 59.90, "currency": "PEN", "lines": [ { "sku": "CAFE-250", "qty": 2, "price": 29.95 } ] }
}

### 19. Feed de eventos: ventas y cambios de artículos, sin los que publicó el propio sistema
GET {{api}}/api/events?since=0&types=sale.*,master.item.*&excludeSource=ERP
Authorization: Bearer {{session.response.body.accessToken}}

### 20. Catálogo de eventos
GET {{api}}/api/events/catalog
Authorization: Bearer {{session.response.body.accessToken}}

### 21. Login del OrgAdmin de la organización (para webhooks). Créelo antes con role "OrgAdmin".
# @name orgadmin
POST {{api}}/api/admin/auth/login
Content-Type: application/json

{ "email": "ti@acme.com", "password": "Clave-Segura-2026!" }

### 22. Registrar webhook (la respuesta trae el secreto de firma)
# @name webhook
POST {{api}}/api/admin/webhooks
Authorization: Bearer {{orgadmin.response.body.accessToken}}
Content-Type: application/json

{ "name": "Backend ERP", "url": "http://localhost:5999/hooks/vortex", "eventTypes": ["sale.*", "master.item.*"], "receiverProduct": "ERP" }

### 23. Historial de entregas
GET {{api}}/api/admin/webhooks/{{webhook.response.body.webhook.id}}/deliveries
Authorization: Bearer {{orgadmin.response.body.accessToken}}
