# Copiar a .env y completar. Nunca subir .env al repositorio.

# Dominio público del hub (sin https://). El DNS debe apuntar a este servidor.
VORTEX_DOMAIN=hub.miempresa.com

# Versión del hub: fijar una versión concreta en producción.
VORTEX_IMAGE=ghcr.io/arcgabito/vortex-api:latest

# Primer PlatformAdmin (solo se usa si aún no existe ninguno). La contraseña no debe contener el email.
VORTEX_ADMIN_EMAIL=ti@miempresa.com
VORTEX_ADMIN_PASSWORD=

# Contraseña de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
SQL_SA_PASSWORD=
# Express (gratis, hasta 10 GB), Standard o Enterprise (requieren licencia), Developer (solo pruebas).
SQL_EDITION=Express

VORTEX_DOCS_ENABLED=true
VORTEX_WEBHOOKS_PRIVATE_NETWORKS=false
