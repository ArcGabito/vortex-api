      "metadata": {
        "description": "Plan de Azure SQL. Basic/S0/S1 (DTU) son los más económicos; GP_S_Gen5_1 es serverless (vCore)."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "Réplicas mínimas. Al menos 1: el despachador de webhooks corre dentro del hub."
      }
    },
    "maxReplicas": {
