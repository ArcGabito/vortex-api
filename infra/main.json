        "administrators": {
          "administratorType": "ActiveDirectory",
          "azureADOnlyAuthentication": true,
          "login": "[format('id-{0}-{1}', parameters('name'), variables('token'))]",
          "sid": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token'))), '2023-01-31').clientId]",
          "tenantId": "[subscription().tenantId]",
