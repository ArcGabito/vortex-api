            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}-{1}', parameters('name'), variables('token'))), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}-{1}', parameters('name'), variables('token')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token'))))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-{1}', parameters('name'), variables('token')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false
          },
          "secrets": "[concat(createArray(createObject('name', variables('signingKeySecretName'), 'keyVaultUrl', format('{0}secrets/{1}', reference(resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)), '2023-07-01').vaultUri, variables('signingKeySecretName')), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token')))), createObject('name', variables('adminPasswordSecretName'), 'keyVaultUrl', reference(resourceId('Microsoft.KeyVault/vaults/secrets', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24), variables('adminPasswordSecretName')), '2023-07-01').secretUri, 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token'))))), if(variables('useRegistry'), createArray(createObject('name', variables('registryPasswordSecretName'), 'value', parameters('registryPassword'))), createArray()))]",
          "registries": "[if(variables('useRegistry'), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUsername'), 'passwordSecretRef', variables('registryPasswordSecretName'))), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "hub",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "env": [
                {
                  "name": "ConnectionStrings__Vortex",
                  "value": "[format('Server=tcp:{0},1433;Database={1};Authentication=Active Directory Managed Identity;User Id={2};Encrypt=True;TrustServerCertificate=False;Connection Timeout=60', reference(resourceId('Microsoft.Sql/servers', format('sql-{0}-{1}', parameters('name'), variables('token'))), '2021-11-01').fullyQualifiedDomainName, 'vortex', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token'))), '2023-01-31').clientId)]"
                },
                {
                  "name": "Jwt__Issuer",
                  "value": "[if(empty(parameters('publicUrl')), format('https://{0}.{1}', variables('appName'), reference(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-{1}', parameters('name'), variables('token'))), '2024-03-01').defaultDomain), parameters('publicUrl'))]"
                },
                {
                  "name": "Jwt__SigningKeyPem",
                  "secretRef": "[variables('signingKeySecretName')]"
                },
                {
                  "name": "Seed__AdminEmail",
                  "value": "[parameters('adminEmail')]"
                },
                {
                  "name": "Seed__AdminPassword",
                  "secretRef": "[variables('adminPasswordSecretName')]"
                },
                {
                  "name": "Docs__Enabled",
                  "value": "[string(parameters('docsEnabled'))]"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 30
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults/secrets', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24), variables('adminPasswordSecretName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token')))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token'))), variables('keyVaultSecretsUser')))]",
        "[resourceId('Microsoft.Sql/servers/databases', format('sql-{0}-{1}', parameters('name'), variables('token')), 'vortex')]",
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-{1}', parameters('name'), variables('token')))]",
        "[resourceId('Microsoft.Resources/deploymentScripts', 'generate-signing-key')]",
        "[resourceId('Microsoft.Sql/servers/firewallRules', format('sql-{0}-{1}', parameters('name'), variables('token')), 'AllowAllWindowsAzureIps')]",
        "[resourceId('Microsoft.Sql/servers', format('sql-{0}-{1}', parameters('name'), variables('token')))]",
        "[resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24))]"
      ]
    }
  ],
  "outputs": {
    "url": {
      "type": "string",
      "metadata": {
        "description": "URL del hub (configurar en los sistemas como Vortex:HubUrl)."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('appName')), '2024-03-01').configuration.ingress.fqdn)]"
    },
    "issuer": {
      "type": "string",
      "metadata": {
        "description": "Issuer de los tokens (para la validación sin conexión en los sistemas)."
      },
      "value": "[if(empty(parameters('publicUrl')), format('https://{0}.{1}', variables('appName'), reference(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}-{1}', parameters('name'), variables('token'))), '2024-03-01').defaultDomain), parameters('publicUrl'))]"
    },
    "containerAppName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)]"
    },
    "sqlServerName": {
      "type": "string",
      "value": "[format('sql-{0}-{1}', parameters('name'), variables('token'))]"
    },
    "databaseName": {
      "type": "string",
      "value": "vortex"
    },
    "identityName": {
      "type": "string",
      "value": "[format('id-{0}-{1}', parameters('name'), variables('token'))]"
    }
  }
}