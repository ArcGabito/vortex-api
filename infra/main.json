      "S1": {
        "name": "S1",
        "tier": "Standard"
      },
      "S2": {
        "name": "S2",
        "tier": "Standard"
      },
      "GP_S_Gen5_1": {
        "name": "GP_S_Gen5",
        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 1
      },
      "GP_S_Gen5_2": {
        "name": "GP_S_Gen5",
        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 2
