      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2021-11-01",
      "name": "[format('{0}/{1}', format('sql-{0}-{1}', parameters('name'), variables('token')), 'AllowAllWindowsAzureIps')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', format('sql-{0}-{1}', parameters('name'), variables('token')))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2021-11-01",
      "name": "[format('{0}/{1}', format('sql-{0}-{1}', parameters('name'), variables('token')), 'vortex')]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "sku": "[variables('sqlSkus')[parameters('sqlSku')]]",
      "properties": "[if(variables('serverless'), createObject('autoPauseDelay', -1, 'minCapacity', json('0.5')), createObject())]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', format('sql-{0}-{1}', parameters('name'), variables('token')))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[format('log-{0}-{1}', parameters('name'), variables('token'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('cae-{0}-{1}', parameters('name'), variables('token'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
