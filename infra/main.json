      "apiVersion": "2023-01-31",
      "name": "[format('id-{0}-setup-{1}', parameters('name'), variables('token'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]"
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)]",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 30
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24), variables('adminPasswordSecretName'))]",
      "properties": {
        "value": "[parameters('adminPassword')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token'))), variables('keyVaultSecretsUser'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUser'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-{1}', parameters('name'), variables('token')))]",
        "[resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-setup-{1}', parameters('name'), variables('token'))), variables('keyVaultSecretsOfficer'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsOfficer'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-setup-{1}', parameters('name'), variables('token'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-setup-{1}', parameters('name'), variables('token')))]",
        "[resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "generate-signing-key",
      "location": "[parameters('location')]",
      "tags": "[variables('allTags')]",
      "kind": "AzureCLI",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-setup-{1}', parameters('name'), variables('token'))))]": {}
        }
      },
      "properties": {
        "azCliVersion": "2.70.0",
        "retentionInterval": "PT1H",
        "cleanupPreference": "OnSuccess",
        "timeout": "PT15M",
        "environmentVariables": [
          {
            "name": "VAULT",
            "value": "[take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)]"
          },
          {
            "name": "SECRET",
            "value": "[variables('signingKeySecretName')]"
          }
        ],
        "scriptContent": "      set -euo pipefail\n      # El permiso recién asignado puede tardar unos minutos en propagarse.\n      # Solo stdout: la CLI escribe avisos en stderr que no deben confundirse con el resultado.\n      count=\"\"\n      for i in $(seq 1 30); do\n        if count=$(az keyvault secret list --vault-name \"$VAULT\" --query \"length([?name=='$SECRET'])\" -o tsv --only-show-errors 2>/dev/null); then break; fi\n        count=\"\"; echo \"Esperando permisos sobre Key Vault ($i)...\"; sleep 10\n      done\n      if [ -z \"$count\" ]; then echo \"Sin acceso a Key Vault $VAULT.\" >&2; exit 1; fi\n      if [ \"$count\" != \"0\" ]; then echo \"La llave de firma ya existe.\"; exit 0; fi\n      key=$(mktemp)\n      if command -v openssl >/dev/null; then\n        openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out \"$key\" 2>/dev/null\n      else\n        python3 -c \"from cryptography.hazmat.primitives.asymmetric import rsa; from cryptography.hazmat.primitives import serialization as s; k=rsa.generate_private_key(65537,3072); open('$key','wb').write(k.private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption()))\"\n      fi\n      az keyvault secret set --vault-name \"$VAULT\" --name \"$SECRET\" --file \"$key\" --content-type application/x-pem-file -o none --only-show-errors\n      rm -f \"$key\"\n      echo \"Llave de firma creada.\"\n    "
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-setup-{1}', parameters('name'), variables('token')))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24)), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-setup-{1}', parameters('name'), variables('token'))), variables('keyVaultSecretsOfficer')))]",
        "[resourceId('Microsoft.KeyVault/vaults', take(format('kv{0}{1}', replace(parameters('name'), '-', ''), variables('token')), 24))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2021-11-01",
      "name": "[format('sql-{0}-{1}', parameters('name'), variables('token'))]",
      "location": "[parameters('location')]",
