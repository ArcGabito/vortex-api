{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "7241108393987503395"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "defaultValue": "vortex",
      "minLength": 2,
      "maxLength": 20,
      "metadata": {
        "description": "Nombre corto de la instalación (minúsculas y guiones). Se usa en el nombre de los recursos."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Región de los recursos. Por defecto, la del grupo de recursos."
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "ghcr.io/arcgabito/vortex-api:latest",
